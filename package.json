{
  "name": "lbs-master",
  "version": "0.1.0",
  "private": true,
  "description": "LBS-Master portable sandbox scaffold (Shanghai domain)",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test tests/portable-paths.test.js tests/gcj.test.js tests/region-catalog.test.js tests/regional-publish.test.js",
    "verify:paths": "node tests/portable-paths.test.js",
    "build:anchors": "node scripts/build-anchors.js",
    "build:grids": "node scripts/build-grids.js",
    "build:grids:fine": "node scripts/build-fine-grids.js",
    "build:zones": "node scripts/build-zones.js",
    "build:water": "node scripts/build-water.js",
    "build:landuse": "node scripts/build-landuse.js",
    "download:osm": "node scripts/download-osm-roads.js",
    "download:osm:core": "node scripts/download-osm-core.js",
    "build:roads:convert": "node scripts/build-roads.js",
    "repair:roads": "node scripts/repair-roads-snap.js",
    "qc:roads": "node scripts/qc-roads.js",
    "build:roads": "node scripts/build-roads-pipeline.js",
    "build:synthetic": "node scripts/build-synthetic.js",
    "verify:synthetic": "node scripts/verify-synthetic.js",
    "build:geo": "node scripts/build-all.js",
    "verify:alignment": "node scripts/verify-alignment.js",
    "build:manifest": "node scripts/build-manifest.js",
    "copy:public-data": "node scripts/copy-public-data.js",
    "copy:regional-data": "node scripts/copy-regional-delivery.js",
    "build": "node scripts/build-all.js",
    "serve": "node scripts/serve-static.js public 4173",
    "serve:npx": "npx --yes serve public -p 4173"
  }
}
