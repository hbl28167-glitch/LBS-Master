{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lbs-master.local/contracts/zone.schema.json",
  "title": "LBS-Master functional zone (05.1)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "zone_id",
    "name",
    "zone_type",
    "centroid_lng",
    "centroid_lat"
  ],
  "properties": {
    "zone_id": {
      "type": "string",
      "description": "Frozen: sh:z:{type}:{slug}"
    },
    "name": { "type": "string" },
    "zone_type": {
      "type": "string",
      "enum": [
        "retail",
        "residential",
        "office",
        "industrial",
        "hub",
        "scenic",
        "rural"
      ]
    },
    "grade": {
      "type": ["string", "null"],
      "description": "retail: premium|mass|community; residential: dense_mass|improve|premium_low"
    },
    "centroid_lng": { "type": "number" },
    "centroid_lat": { "type": "number" },
    "color_token": { "type": "string" },
    "batch": { "type": "string" },
    "source": { "type": "string" },
    "labels": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
